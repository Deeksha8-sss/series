import java.util.Scanner;
public class Main{
    public static void main(String[]agrs){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int rev=0;
        int sum=0;
        while(n>0){
            int digit=n%10;
            rev=rev*10+digit;
            sum=sum+digit;
            n/=10;
        }
        System.out.println(rev+"");
        System.out.println(sum+"");
    }
}
